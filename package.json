{
  "name": "observatory",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "tick": "node scripts/tick.mjs",
    "collect": "node scripts/collect.mjs",
    "dashboard": "node serve-local.mjs",
    "build": "vite build",
    "preview": "node scripts/preview.mjs",
    "demo": "vite build && node scripts/demo.mjs",
    "test": "node --import ./test/pin-timezone.mjs --import ./test/private-temp.mjs --test \"test/*.test.mjs\" \"scripts/*.test.mjs\"",
    "lint": "oxlint",
    "format": "oxfmt",
    "status": "node scripts/status.mjs",
    "doctor": "node scripts/doctor.mjs",
    "icons": "node scripts/make-icons.mjs",
    "check:build": "node scripts/harness/stale-build.mjs . --url http://127.0.0.1:5601",
    "check:numbers": "node scripts/harness/numbers.mjs",
    "check:browser": "node scripts/harness/browser.mjs"
  },
  "dependencies": {
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "@json-render/core": "0.22.0",
    "@json-render/react": "0.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "license": "MIT",
  "type": "module"
}
